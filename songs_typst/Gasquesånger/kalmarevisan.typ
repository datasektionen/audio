#import "template.typ": songbook, song, songmeta, songtext

#song(title: "Kalmarevisan")[
  #songmeta[
    Melodi: Traditionell \ 
    Text: G S Kallstenius \ 
  ]

  #songtext[
    ||: <b>Uti Kalmare stad,</b> \ 
    ja där finns det ingen kvast :|| \ 
    förrän lördagen. \ 

    <b>Hej dick!</b> \ 
    Hej dack! \ 
    <b>Jag slog i,</b> \ 
    och vi drack. \ 
    <b>Hej dickom dickom dack!</b> \ 
    Hej dickom dickom dack! \ 
    För uti Kalmare stad, \ 
    ja där finns det ingen kvast \ 
    förrän lördagen. \ 

    ||: <b>När som bonden kommer hem</b> \ 
    kommer bondepartnern ut :|| \ 
    och är så stor i sin trut. \ 

    Hej dick… \ 

    ||: <b>“Var är pengarna du fått?”</b> \ 
    “Jo, dom har jag supit opp :|| \ 
    uppå Kalmare slott.” \ 

    Hej dick… \ 

    ||: <b>“Jag ska mäla dig an</b> \ 
    för vår kronbefallningsman :|| \ 
    och du ska få skam.” \ 

    Hej dick… \ 

    ||: <b>“Kronbefallningsmannen vår</b> \ 
    satt på krogen igår :|| \ 
    och var full som ett får.” \ 

    Hej dick… \ 
  ]
]
